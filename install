#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$(realpath -- "$0")")"

if [[ ${XDG_SESSION_TYPE:-} != wayland || ${XDG_CURRENT_DESKTOP:-} != *KDE* ]]; then
    echo "Run this installer inside a KDE Plasma Wayland session." >&2
    exit 1
fi
for bin in busctl gsettings kpackagetool6 kwriteconfig6 paplay systemctl; do
    command -v "$bin" >/dev/null || { echo "Missing dependency $bin" >&2; exit 1; }
done

data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
base="$data_home/select-to-speak"
local_gtk="$base/runtime/gtk/usr/lib64"
if [[ -f "$local_gtk/libgtk4-layer-shell.so.0" ]]; then
    export GI_TYPELIB_PATH="$local_gtk/girepository-1.0${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
    export LD_LIBRARY_PATH="$local_gtk${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
/usr/bin/python3 - <<'PY'
import gi
gi.require_version("Atspi", "2.0")
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_foreign("cairo")
from gi.repository import Atspi, Gtk4LayerShell
PY

mkdir -p "$base/app/reader" "$base/voices" "$config_home/systemd/user" "$config_home/select-to-speak"
touch "$config_home/select-to-speak/env"
if [[ ${1:-} == --with-piper ]]; then
    piper_python=${2:-python3.14}
    "$piper_python" -m venv "$base/piper"
    "$base/piper/bin/python" -m pip install 'piper-tts==1.7.0'
    "$base/piper/bin/python" -m piper.download_voices --download-dir "$base/voices" \
        en_US-lessac-medium en_US-ryan-medium en_GB-alba-medium
elif [[ $# != 0 ]]; then
    echo "Usage: ./install [--with-piper [path-to-python-3.14]]" >&2
    exit 2
fi

install -Dm644 plasmoid/contents/icons/select-to-speak-symbolic.svg \
    "$data_home/icons/hicolor/scalable/apps/select-to-speak-symbolic.svg"
if [[ -d "$data_home/plasma/plasmoids/org.kde.plasma.selecttospeak" ]]; then
    kpackagetool6 --type Plasma/Applet --upgrade plasmoid
else
    kpackagetool6 --type Plasma/Applet --install plasmoid
fi

if systemctl --user is-active --quiet select-to-speak.service; then
    systemctl --user stop select-to-speak.service
fi
install -m 755 launch "$base/app/launch"
install -m 644 reader/*.py "$base/app/reader/"
cat > "$config_home/systemd/user/select-to-speak.service" <<UNIT
[Unit]
Description=Select to Speak
PartOf=graphical-session.target
After=graphical-session-pre.target plasma-kwin_wayland.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart="$base/app/launch"
EnvironmentFile=$config_home/select-to-speak/env
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
UNIT

# Enable desktop accessibility for apps. The reader enables the session bus at startup.
gsettings set org.gnome.desktop.interface toolkit-accessibility true

if [[ -d "$data_home/kwin/scripts/select-to-speak" ]]; then
    busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting unloadScript s select-to-speak >/dev/null
    read_action='Select to Speak: Read aloud'
    # Replace the former Meta+Shift+F8 and Ctrl+Shift+Return defaults.
    case $(busctl --user call org.kde.kglobalaccel /kglobalaccel org.kde.KGlobalAccel \
        shortcutKeys as 4 kwin "$read_action" KWin "$read_action") in
        'a(ai) 1 4 318767159 0 0 0'|'a(ai) 1 4 117440516 0 0 0')
            busctl --user call org.kde.kglobalaccel /kglobalaccel org.kde.KGlobalAccel unregister ss kwin "$read_action" >/dev/null
            ;;
    esac
    for old_action in 'Select to Speak: Stop reading' 'Select to Speak: Read or pause' 'Select to Speak: Stop' \
        'Select to Speak: From pointer' 'Select to Speak: Cancel' 'Select to Speak: Read or stop' \
        'Select to Speak: Read without Alt' 'Select to Speak: Stop with Ctrl'; do
        busctl --user call org.kde.kglobalaccel /kglobalaccel org.kde.KGlobalAccel unregister ss kwin "$old_action" >/dev/null
    done
    kpackagetool6 --type KWin/Script --upgrade kwin
else
    kpackagetool6 --type KWin/Script --install kwin
fi
kwriteconfig6 --file kwinrc --group Plugins --key select-to-speakEnabled true
busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure
busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting start

systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
systemctl --user daemon-reload
systemctl --user enable --now select-to-speak.service
for try in {1..30}; do
    if busctl --user call org.kde.SelectToSpeak /SelectToSpeak org.kde.SelectToSpeak Status 2>/dev/null; then
        exit 0
    fi
    sleep 0.15
done
journalctl --user -u select-to-speak.service -n 20 --no-pager >&2
exit 1
